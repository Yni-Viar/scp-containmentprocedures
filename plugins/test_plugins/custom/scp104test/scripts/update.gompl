get_follow()
get_distance_to_player()
if builtin_follow != "" then
    if builtin_distance_to_player > 9.0 then
        get_player_front_facing()
        get_player_global_position()
        set_global_pos(builtin_player_global_pos_x + builtin_player_front_facing_x * 2, builtin_player_global_pos_y + builtin_player_front_facing_y * 2, builtin_player_global_pos_z + builtin_player_front_facing_z * 2)
    end
end
